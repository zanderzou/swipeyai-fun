---
import { site } from "../data/site";
import { measurementId } from "../data/analytics";
import { uiCopy } from "../data/localized-ui";
import type { LocaleSlug } from "../data/localized-swipey";
interface Props { locale?: LocaleSlug }
const { locale } = Astro.props;
const words = locale ? uiCopy[locale] : null;
const statuses: Record<LocaleSlug, { signal: string; on: string; off: string }> = {
  ja: { signal: "ブラウザーのプライバシー設定を尊重し、解析を停止しています。", on: "解析は有効です。「許可しない」を選ぶと同意を取り消せます。", off: "解析は停止中です。この選択は当サイトのみに適用されます。" },
  ko: { signal: "브라우저의 개인정보 보호 신호를 존중하여 방문 분석을 끕니다.", on: "분석이 켜져 있습니다. '동의하지 않음'을 누르면 동의를 철회할 수 있습니다.", off: "분석이 꺼져 있습니다. 이 선택은 이 사이트에만 적용됩니다." },
  "zh-hant": { signal: "我們尊重瀏覽器的隱私訊號，流量分析已關閉。", on: "流量分析目前開啟；點選「不同意」即可撤回同意。", off: "流量分析目前關閉；此選擇僅適用於本站。" },
  es: { signal: "Respetamos la señal de privacidad de tu navegador; la analítica está desactivada.", on: "La analítica está activada. Pulsa «No, gracias» para retirar tu consentimiento.", off: "La analítica está desactivada. Esta elección solo afecta a este sitio." },
  "pt-br": { signal: "Respeitamos o sinal de privacidade do navegador; a análise está desligada.", on: "A análise está ativada. Selecione «Não, obrigado» para retirar seu consentimento.", off: "A análise está desligada. Sua escolha vale apenas para este site." },
  ru: { signal: "Мы учитываем сигнал конфиденциальности браузера: аналитика отключена.", on: "Аналитика включена. Нажмите «Нет, спасибо», чтобы отозвать согласие.", off: "Аналитика отключена. Выбор действует только на этом сайте." },
  de: { signal: "Das Datenschutzsignal Ihres Browsers wird beachtet; die Analyse bleibt aus.", on: "Die Analyse ist aktiv. Mit „Nein, danke“ können Sie die Einwilligung widerrufen.", off: "Die Analyse ist ausgeschaltet. Diese Wahl gilt nur für diese Website." },
  fr: { signal: "Le signal de confidentialité du navigateur est respecté ; la mesure d'audience reste désactivée.", on: "La mesure d'audience est active. Cliquez sur « Non merci » pour retirer votre accord.", off: "La mesure d'audience est désactivée. Ce choix ne concerne que ce site." },
  ar: { signal: "نحترم إشارة الخصوصية في متصفحك؛ التحليلات متوقفة.", on: "التحليلات مفعلة. اختر «لا، شكراً» لسحب موافقتك.", off: "التحليلات متوقفة. يسري هذا الاختيار على هذا الموقع فقط." },
};
const currentStatus = locale ? statuses[locale] : null;
const domain = new URL(site.url).hostname;
---
{measurementId && <>
  <div id="site-analytics" data-measurement-id={measurementId} data-domain={domain} data-privacy-signal={currentStatus?.signal ?? "Your browser privacy signal is respected. Analytics is off."} data-status-on={currentStatus?.on ?? "Analytics is on. Choose No thanks to withdraw your consent."} data-status-off={currentStatus?.off ?? "Analytics is off. Your choice applies only to this website."}>
    <div class="analytics-footer"><button type="button" id="analytics-settings">{words?.consentSettings ?? "Analytics preferences"}</button></div>
    <aside id="analytics-notice" role="region" aria-label={words?.consentSettings ?? "Analytics preferences"} hidden>
      <div><strong>{words?.consentTitle ?? "Optional analytics"}</strong><p>{words?.consentBody ?? "May we use Google Analytics to understand visits and improve this guide? No advertising tracking."} <a href={locale ? `/${locale}/privacy/` : "/privacy/"}>{words?.privacy ?? "Privacy details"}</a>.</p><p id="analytics-status" aria-live="polite"></p></div>
      <div class="analytics-actions"><button type="button" id="analytics-decline">{words?.consentDecline ?? "No thanks"}</button><button type="button" id="analytics-accept">{words?.consentAccept ?? "Allow analytics"}</button></div>
    </aside>
  </div>
  <script is:inline src="/analytics-consent.js"></script>
</>}
<style>
  .analytics-footer{padding:12px 24px 20px;text-align:center}
  #analytics-settings{font:inherit;font-size:12px;line-height:1.5;color:inherit;background:transparent;border:0;text-decoration:underline;text-underline-offset:3px;cursor:pointer;opacity:.8}
  #analytics-notice[hidden]{display:none!important}
  #analytics-notice{box-sizing:border-box;position:fixed;inset:auto 20px 20px;z-index:1000;margin:0 auto;max-width:920px;display:flex;align-items:center;gap:24px;padding:20px 24px;border:1px solid #5b5669;border-radius:16px;background:#19171f;color:#f6f3fc;box-shadow:0 8px 40px #0005;font:14px/1.55 system-ui,sans-serif;text-align:left}
  #analytics-notice strong{font-size:15px}
  #analytics-notice p{font:inherit;color:#e0dce9;margin:5px 0 0;max-width:64ch}
  #analytics-notice a{color:#e7d8ff;text-decoration:underline}
  #analytics-status:empty{display:none}
  .analytics-actions{display:flex;flex-shrink:0;gap:8px}
  .analytics-actions button{appearance:none;cursor:pointer;border:1px solid #736a82;border-radius:9px;padding:10px 14px;white-space:nowrap;background:transparent;color:#fff;font:600 13px/1.4 system-ui,sans-serif}
  #analytics-accept{background:#eadfff;color:#251a33;border-color:#eadfff}
  .analytics-actions button:disabled{opacity:.5;cursor:not-allowed}
  #site-analytics button:focus-visible,#site-analytics a:focus-visible{outline:3px solid #be9bff;outline-offset:4px}
  @media(max-width:640px){#analytics-notice{inset:auto 12px 12px;padding:16px;display:block}.analytics-actions{margin-top:12px;display:grid;grid-template-columns:1fr 1fr}.analytics-actions button{padding:10px 8px}}
</style>
