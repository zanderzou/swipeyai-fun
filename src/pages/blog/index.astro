---
import{getCollection}from"astro:content";import BaseLayout from"../../layouts/BaseLayout.astro";import PostCard from"../../components/PostCard.astro";import{site}from"../../data/site";const posts=(await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"Swipey AI comparisons and safety guides",url:`${site.url}/blog/`,description:"Independent Swipey AI comparisons, safety checklists, and AI girlfriend research.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="Swipey AI Blog: Reviews, Comparisons & Safety" description="Independent Swipey AI guides covering Create AI, Feed, voice calls, images, video, Fanclub, privacy, pricing, Candy AI, CrushOn AI, and alternatives." keywords={["Swipey AI blog","Swipey AI review","Swipey AI comparison","AI girlfriend alternatives","is Swipey AI safe"]} jsonLd={jsonLd}><section class="page-hero"><div class="ambient-orb"></div><span>SWIPEY AI FIELD NOTES</span><h1>Fast answers.<br/>Clear tradeoffs.</h1><p>Original, source-led decision guides for Swipey AI and the wider adult AI companion category.</p></section><section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index}/>)}</div></section></BaseLayout>
