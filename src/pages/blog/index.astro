---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { site } from "../../data/site";
const posts = (await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"Swipey AI VS comparisons",url:`${site.url}/blog/`,description:"Five focused Swipey AI comparison guides covering features, strengths, weaknesses, cost, privacy, and best fit.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="Swipey AI Comparisons: Five Detailed VS Guides" description="Compare Swipey AI with Candy AI, CrushOn AI, OurDream AI, GirlfriendGPT, Lovescape using practical strengths, weaknesses, privacy, cost, and workflow tests." keywords={["Swipey AI comparison","Swipey AI vs","Swipey AI alternatives","best Swipey AI alternative"]} jsonLd={jsonLd}>
  <section class="page-hero"><div class="ambient-orb"></div><span>SWIPEY AI COMPARISON LIBRARY</span><h1>Five useful VS guides.<br />One repeatable test.</h1><p>Detailed Swipey AI comparisons focused on real differences, advantages, disadvantages, cost, privacy, and the user each product suits.</p></section>
  <section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index} />)}</div></section>
</BaseLayout>
